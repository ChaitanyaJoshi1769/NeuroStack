# Multi-stage build for Agent Orchestrator
FROM node:20-alpine AS builder

WORKDIR /build

# Install dependencies
RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml* .npmrc* ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm run build

# ==================== Runtime ====================
FROM node:20-alpine

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml* .npmrc* ./
RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /build/apps/agent-orchestrator/dist ./dist
COPY --from=builder /build/apps/agent-orchestrator/src ./src

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})" || exit 1

CMD ["npm", "run", "start"]
