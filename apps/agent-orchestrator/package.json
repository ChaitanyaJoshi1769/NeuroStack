{
  "name": "neurostack-agent-orchestrator",
  "version": "0.1.0",
  "description": "Agent orchestration service for NeuroStack",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@neurostack/shared": "workspace:*",
    "@neurostack/agent-core": "workspace:*",
    "@neurostack/memory-system": "workspace:*",
    "@neurostack/semantic-engine": "workspace:*",
    "@neurostack/vector-runtime": "workspace:*",
    "express": "^4.18.2",
    "pino": "^8.17.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}
