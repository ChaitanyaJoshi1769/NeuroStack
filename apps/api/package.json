{
  "name": "neurostack-api",
  "version": "0.1.0",
  "description": "FastAPI orchestration service for NeuroStack",
  "main": "dist/main.py",
  "scripts": {
    "dev": "uvicorn main:app --reload --port 8000",
    "start": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "lint": "flake8 .",
    "format": "black .",
    "type-check": "mypy .",
    "clean": "rm -rf __pycache__ .pytest_cache dist build *.egg-info"
  },
  "dependencies": [
    "fastapi==0.104.1",
    "uvicorn==0.24.0",
    "pydantic==2.5.0",
    "sqlalchemy==2.0.23",
    "python-dotenv==1.0.0",
    "pydantic-settings==2.1.0",
    "httpx==0.25.1"
  ]
}
